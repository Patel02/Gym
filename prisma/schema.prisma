generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  ADMIN
  REFEREE
  MEET_DIRECTOR
  SUPER_ADMIN
}

enum Permission {
  MANAGE_MEETS
  MANAGE_MEMBERS
  MANAGE_RECORDS
  LIVE_SCORING
  CMS_PUBLISH
}

enum MeetStatus {
  APPROVED
  PENDING_PAYMENT
  WAITLISTED
  REJECTED
}

enum Division {
  OPEN
  JUNIOR
  SUB_JUNIOR
  MASTER_1
  MASTER_2
  MASTER_3
  MASTER_4
}

enum EquipmentType {
  RAW
  EQUIPPED
  CLASSIC_RAW
}

enum Gender {
  MALE
  FEMALE
}

enum LiftType {
  SQUAT
  BENCH
  DEADLIFT
  TOTAL
}

enum MembershipPlan {
  ANNUAL_ATHLETE
  LIFETIME
  COACH_OFFICIAL
}

enum WeightClass {
  WC_47
  WC_52
  WC_57
  WC_59
  WC_63
  WC_66
  WC_69
  WC_74
  WC_76
  WC_83
  WC_84
  WC_84_PLUS
  WC_93
  WC_105
  WC_120
  WC_120_PLUS
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique
  password      String?
  image         String?
  phone         String?
  role          UserRole           @default(MEMBER)
  permissions   Permission[]
  isActive      Boolean            @default(true)
  mustChangePassword Boolean        @default(false)
  profile       Profile?
  memberships   Membership[]
  registrations MeetRegistration[]
  results       Result[]
  auditLogs     AuditLog[]         @relation("AdminAction")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  nationalRecords NationalRecord[]
  deletionRequest DeletionRequest?
  subscription  FederationSubscription?
  branding      TenantBranding?
  refereeProfile RefereeProfile?

  @@index([email])
}

enum SubscriptionPlan {
  FREE
  MONTHLY
  SIX_MONTH
  YEARLY
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  PENDING_APPROVAL
  SUSPENDED
}

model FederationSubscription {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName        String             @default("State Powerlifting Association")
  planType                SubscriptionPlan   @default(MONTHLY)
  status                  SubscriptionStatus @default(ACTIVE)
  startDate               DateTime           @default(now())
  endDate                 DateTime
  monthlyEventQuota       Int                @default(4)
  extraEventCredits       Int                @default(0)
  pricePaid               Float              @default(2999)
  currency                String             @default("INR")
  contactPhone            String?
  paymentUtr              String?
  reactivationRequestedAt DateTime?
  reactivationNotes       String?
  reactivationPlanType    SubscriptionPlan?
  approvedBy              String?
  approvedAt              DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([status, endDate])
  @@index([userId])
}

model TenantBranding {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String   @default("State Powerlifting Association")
  tagline          String?  @default("Affiliated Member State Body")
  slug             String?  @unique
  logoUrl          String?
  primaryColor     String   @default("#e6501b")
  secondaryColor   String   @default("#0a0a0a")
  sealText         String?  @default("OFFICIAL RATIFIED SEAL")
  presidentName    String?  @default("President")
  presidentSignUrl String?
  secretaryName    String?  @default("General Secretary")
  secretarySignUrl String?
  isApproved       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([userId])
}


model DeletionRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuthRateLimit {
  key        String   @id
  count      Int      @default(0)
  windowStart DateTime
  createdAt  DateTime @default(now())

  @@index([windowStart])
}

model Profile {
  id          String      @id @default(cuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender      Gender
  weightClass WeightClass
  clubId      String?
  club        Club?       @relation(fields: [clubId], references: [id])
  phoneNumber String?
  coachPhone  String?
  coachName   String?
}

model Club {
  id       String    @id @default(cuid())
  name     String    @unique
  state    String
  athletes Profile[]

  @@index([state])
}

model Membership {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType      MembershipPlan
  amountPaid    Float
  status        String
  cardNumber    String         @unique
  startDate     DateTime       @default(now())
  endDate       DateTime
  idCardPdfUrl  String?
  badgeUrl      String?
  securityHash  String?

  @@index([status, endDate])
}

model Event {
  id                String             @id @default(cuid())
  title             String
  date              DateTime
  location          String
  status            String
  entryFee          Float
  registrationOpen  DateTime
  registrationClose DateTime
  maxAthletes       Int
  meetDirector      String
  posterUrl         String?
  registrations     MeetRegistration[]
  results           Result[]
  nationalRecords   NationalRecord[]
  refereeAssignments RefereeAssignment[]

  @@index([status, date])
}

model MeetRegistration {
  id           String        @id @default(cuid())
  userId       String
  eventId      String
  division     Division      @default(OPEN)
  equipment    EquipmentType @default(RAW)
  status       MeetStatus    @default(PENDING_PAYMENT)
  paymentRef   String?
  bodyweight   Float?
  lotNumber    Int?
  contactPhone String?
  coachPhone   String?
  user         User          @relation(fields: [userId], references: [id])
  event        Event         @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([eventId, status])
}

model Result {
  id           String   @id @default(cuid())
  userId       String
  eventId      String
  squat1       Float?
  squat2       Float?
  squat3       Float?
  bestSquat    Float?
  bench1       Float?
  bench2       Float?
  bench3       Float?
  bestBench    Float?
  deadlift1    Float?
  deadlift2    Float?
  deadlift3    Float?
  bestDeadlift Float?
  total        Float?
  ipfGlPoints  Float?
  rank         Int?
  version      Int      @default(1)
  user         User     @relation(fields: [userId], references: [id])
  event        Event    @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([total, ipfGlPoints])
}

model NationalRecord {
  id           String        @id @default(cuid())
  liftType     LiftType
  weightClass  WeightClass
  division     Division
  equipment    EquipmentType
  gender       Gender
  weight       Float
  athleteId    String
  athlete      User          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  meetId       String
  meet         Event         @relation(fields: [meetId], references: [id], onDelete: Cascade)
  dateSet      DateTime

  @@unique([liftType, weightClass, division, equipment, gender])
  @@index([weightClass, gender])
}

model Certificate {
  id               String   @id @default(cuid())
  verificationCode String   @unique
  userId           String
  eventId          String
  issueDate        DateTime @default(now())
  pdfUrl           String?
  badgeUrl         String?
  securityHash     String?
  rank             Int?
  medal            String?

  @@index([verificationCode])
}

model News {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  content       String
  featuredImage String?
  published     Boolean  @default(false)
  publishedAt   DateTime @default(now())

  @@index([published, publishedAt])
}

model Circular {
  id          String   @id @default(cuid())
  title       String
  fileUrl     String
  publishedAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminAction", fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  details    String
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminId, timestamp])
}

enum RefereeCategory {
  STATE_CAT_2
  NATIONAL_CAT_2
  NATIONAL_CAT_1
  IPF_INTERNATIONAL
}

enum OfficialRole {
  CHIEF_REFEREE
  SIDE_REFEREE_LEFT
  SIDE_REFEREE_RIGHT
  JURY_PRESIDENT
  JURY_MEMBER
  TECHNICAL_CONTROLLER
}

model RefereeProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber     String              @unique
  category          RefereeCategory     @default(NATIONAL_CAT_2)
  stateAffiliation  String              @default("Gujarat")
  isActive          Boolean             @default(true)
  totalMeetsJudged  Int                 @default(0)
  licenseValidUntil DateTime
  assignments       RefereeAssignment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([category, stateAffiliation])
  @@index([userId])
}

model RefereeAssignment {
  id               String          @id @default(cuid())
  refereeProfileId String
  refereeProfile   RefereeProfile  @relation(fields: [refereeProfileId], references: [id], onDelete: Cascade)
  eventId          String
  event            Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  platformName     String          @default("Platform 1")
  role             OfficialRole    @default(CHIEF_REFEREE)
  flightGroup      String?         @default("Flight A")
  shiftDate        DateTime
  status           String          @default("ASSIGNED")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([refereeProfileId, eventId, role])
  @@index([eventId, platformName])
  @@index([refereeProfileId])
}

model WhatsappQueueAlertLog {
  id            String   @id @default(cuid())
  meetId        String
  lifterId      String
  lifterName    String
  phoneNumber   String
  queuePosition String   // "ON_PLATFORM" | "IN_THE_HOLE" | "IN_THE_RACK"
  attemptInfo   String
  messageText   String
  channel       String   // "TWILIO_API" | "MANUAL_WA_ME" | "SIMULATION"
  status        String   // "SENT" | "DELIVERED" | "CLICKED" | "FAILED"
  errorDetails  String?
  sentByRole    String?  // "ADMIN" | "COACH" | "SYSTEM" | "SUPER_ADMIN"
  createdAt     DateTime @default(now())

  @@index([meetId, createdAt])
  @@index([lifterId])
}

model WhatsappSaaSConfig {
  id                    String   @id @default("default")
  twilioAccountSid      String?
  twilioAuthToken       String?
  twilioPhoneNumber     String?  @default("whatsapp:+14155238886")
  interaktApiKey        String?
  isAutoDispatchEnabled Boolean  @default(false)
  alertCurtainMinutes   Int      @default(3)
  fallbackToManual      Boolean  @default(true)
  customMessageTemplate String?
  updatedAt             DateTime @updatedAt
}
