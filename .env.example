# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/federation_gym?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-unique-random-secret"
APP_URL="http://localhost:3000"

# Transactional email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Federation <noreply@example.com>"

# UploadThing
UPLOADTHING_TOKEN=""

# Referee registration
REFEREE_INVITE_CODE=""

# Super-admin setup (only needed while running the setup script)
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NAME=""
SUPERADMIN_REPLACE_EXISTING="false"
SUPERADMIN_SETUP_KEY=""

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe Payment Gateway (optional, alternative to Razorpay)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
